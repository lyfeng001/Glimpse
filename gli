#!/bin/sh
# Glimpse command line. Works from any directory and through a symlink on your PATH
# (`./gli install` creates ~/.local/bin/gli -> this file).
#
#   gli setup            create .venv, install dependencies, create config.json
#   gli install          put `gli` on your PATH (symlink in ~/.local/bin, or $GLIMPSE_BIN_DIR)
#   gli uninstall        remove that symlink
#   gli hub              run the hub (web app + relay) in the foreground
#   gli url              one-time login link for a new device (single use, 10 minutes)
#   gli password         set / change the login password
#   gli devices          list logged-in devices; gli logout ID|all logs them out
#   gli run claude       start a Claude Code session here, visible on the phone (Ctrl-] detaches)
#   gli run codex        start a Codex session; gli run codex --resume ID continues a conversation
#   gli ls | kill ID     list / stop sessions on this machine
#   gli attach [ID]      attach this terminal (no ID: latest live session; M2:ID for another machine)
#   gli shell-init       shell functions so plain `claude` / `codex` run as Glimpse sessions
#   gli new [PATH]       open the new-session form in the browser with PATH (default: here) filled in
#   gli finder-install   Finder right-click → 快速操作 → 用 Glimpse 新建会话 (macOS); gli finder-uninstall removes it
#   gli test             run the test suite
set -e

# resolve this script through any chain of symlinks, so DIR is the project root even when called as
# ~/.local/bin/gli (macOS has no `readlink -f`)
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd -P)"
PY="$DIR/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || true)"
[ -n "$PY" ] || { echo "gli: python3 not found" >&2; exit 1; }
HUB="$DIR/hub/server.py"
AGENT="$DIR/agent/glimpse_agent.py"
BIN_DIR="${GLIMPSE_BIN_DIR:-$HOME/.local/bin}"

case "${1:-help}" in
  setup)
    [ -x "$DIR/.venv/bin/python" ] || python3 -m venv "$DIR/.venv"
    "$DIR/.venv/bin/pip" install -q -r "$DIR/requirements.txt"
    if [ ! -f "$DIR/config.json" ]; then
      cp "$DIR/config.example.json" "$DIR/config.json"
      chmod 600 "$DIR/config.json"
    fi
    echo "done. edit $DIR/config.json, then run: gli hub   (gli install puts gli on your PATH)" ;;
  install)
    mkdir -p "$BIN_DIR"
    ln -sf "$DIR/gli" "$BIN_DIR/gli"
    echo "linked $BIN_DIR/gli -> $DIR/gli"
    case ":$PATH:" in
      *":$BIN_DIR:"*) ;;
      *) echo "note: $BIN_DIR is not on your PATH; add this to ~/.zshrc:  export PATH=\"$BIN_DIR:\$PATH\"" ;;
    esac ;;
  uninstall)
    for n in gli glimpse; do [ -L "$BIN_DIR/$n" ] && rm -f "$BIN_DIR/$n" && echo "removed $BIN_DIR/$n"; done; true ;;
  hub)      shift; exec "$PY" "$HUB" "$@" ;;
  url)      exec "$PY" "$HUB" --print-url ;;
  password) exec "$PY" "$HUB" --set-password ;;
  devices)  exec "$PY" "$HUB" --devices ;;
  logout)   shift; exec "$PY" "$HUB" --revoke "${1:?usage: gli logout DEVICE_ID|all}" ;;
  test)     exec "$PY" -m pytest -q "$DIR/tests" ;;
  new)
    # the new-session form in the browser, with this computer and PATH (default: here) filled in
    URL="$("$PY" "$HUB" --new-url "${2:-.}")"
    if [ "$(uname)" = Darwin ]; then exec open "$URL"; fi
    if command -v xdg-open >/dev/null 2>&1; then exec xdg-open "$URL"; fi
    echo "$URL" ;;
  finder-install)   exec "$PY" "$DIR/hub/finder.py" install ;;
  finder-uninstall) exec "$PY" "$DIR/hub/finder.py" uninstall ;;
  attach)
    shift
    # attaching through the hub needs aiohttp (the .venv); without it only local sessions can be attached
    if "$PY" -c "import aiohttp" 2>/dev/null; then exec "$PY" "$DIR/hub/attach_client.py" "$@"; fi
    exec "$PY" "$AGENT" attach "$@" ;;
  help|-h|--help)
    sed -n '2,/^set -e/p' "$SELF" | sed -e '/^set -e/d' -e 's/^# \{0,1\}//' ;;
  *)        exec "$PY" "$AGENT" "$@" ;;
esac
